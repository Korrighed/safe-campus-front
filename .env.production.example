# Variables consommees par docker-compose.prod.yml (a saisir dans la configuration de l'hebergement, pas
# de fichier .env copie dans l'image en prod). A garder synchronise avec le bloc
# `environment:` de docker-compose.prod.yml si l'un des deux change.

FRONT_PORT=3000

# URL publique HTTPS du back (Safe-Campus-back), utilisee par le navigateur ET
# par le SSR (pas de reseau Docker partage entre les deux stacks en prod).
NUXT_PUBLIC_API_BASE=https://api.safe-campus.example
