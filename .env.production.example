# Variables a saisir dans la configuration de l'hebergement (service Render, ou bloc
# `environment:` de docker-compose.prod.yml). Aucun fichier .env n'est copie dans l'image
# en prod ; les .env.* reels sont ignores par git et par Docker.

FRONT_PORT=3000

# URL publique HTTPS du back (Safe-Campus-back), utilisee par le NAVIGATEUR.
# Lue au demarrage du serveur : elle peut changer sans rebuild.
NUXT_PUBLIC_API_BASE=https://api.safe-campus.example

# URL du back utilisee par le rendu cote SERVEUR (SSR). Sans reseau Docker partage entre
# les deux stacks, c'est la meme URL publique que ci-dessus.
# A DEFINIR A L'EXECUTION : nuxt.config.ts calcule sa valeur par defaut au build, avant
# que NUXT_PUBLIC_API_BASE n'existe. Absente, le serveur interroge http://localhost:8000
# et les pages de contenu repondent 404 « Rubrique introuvable ».
NUXT_API_BASE_INTERNAL=https://api.safe-campus.example
